diff --git a/Marlin/src/gcode/feature/i2c/M3427.cpp b/Marlin/src/gcode/feature/i2c/M3427.cpp
new file mode 100644
index 0000000000..913272617f
--- /dev/null
+++ b/Marlin/src/gcode/feature/i2c/M3427.cpp
@@ -0,0 +1,159 @@
+/**
+ * M3427 - Read the selected LumenPnP vacuum pressure sensor.
+ *
+ * The sensor-select strap and HBP ambient zero are sampled during boot.
+ *
+ * Usage:
+ *   M3427 T1  ; VAC1
+ *   M3427 T2  ; VAC2
+ */
+
+#include "../../../inc/MarlinConfig.h"
+
+#if ENABLED(LUMEN_SELECTABLE_VACUUM_SENSOR)
+
+#include "../../gcode.h"
+#include <Wire.h>
+
+namespace {
+  constexpr uint8_t PCA9545A_ADDRESS = 0x70;
+  constexpr uint8_t GZP6857D_ADDRESS = 0x6D;
+  constexpr uint8_t HBP1201D4_ADDRESS = 0x58;
+  constexpr int32_t PRESSURE_SPAN_PA = 100000;
+  constexpr int32_t PRESSURE_COUNTS = 1L << 21;
+
+  bool sensor_selected = false;
+  bool use_hbp1201d4 = false;
+  uint8_t initialized_tools = 0;
+  uint8_t zeroed_tools = 0;
+  int32_t hbp_zero_counts[2] = { 0, 0 };
+
+  void select_sensor_once() {
+    if (sensor_selected) return;
+    SET_INPUT_PULLUP(LUMEN_VACUUM_SENSOR_SELECT_PIN);
+    use_hbp1201d4 = !READ(LUMEN_VACUUM_SENSOR_SELECT_PIN);
+    sensor_selected = true;
+  }
+
+  bool select_tool(const uint8_t tool) {
+    if (!WITHIN(tool, 1, 2)) return false;
+    Wire.beginTransmission(I2C_ADDRESS(PCA9545A_ADDRESS));
+    Wire.write(uint8_t(1U << (tool - 1)));
+    return Wire.endTransmission() == 0;
+  }
+
+  bool write_register(const uint8_t address, const uint8_t reg, const uint8_t value) {
+    Wire.beginTransmission(I2C_ADDRESS(address));
+    Wire.write(reg);
+    Wire.write(value);
+    return Wire.endTransmission() == 0;
+  }
+
+  bool read_registers(const uint8_t address, const uint8_t reg, uint8_t * const data, const uint8_t count) {
+    Wire.beginTransmission(I2C_ADDRESS(address));
+    Wire.write(reg);
+    if (Wire.endTransmission() != 0) return false;
+
+    if (Wire.requestFrom(I2C_ADDRESS(address), count) != count) return false;
+    for (uint8_t i = 0; i < count; ++i) {
+      if (!Wire.available()) return false;
+      data[i] = Wire.read();
+    }
+    return true;
+  }
+
+  bool read_pressure_counts(const uint8_t tool, int32_t &signed_counts, uint8_t * const raw_data) {
+    select_sensor_once();
+    if (!select_tool(tool)) return false;
+
+    const uint8_t tool_mask = uint8_t(1U << (tool - 1));
+    const uint8_t sensor_address = use_hbp1201d4 ? HBP1201D4_ADDRESS : GZP6857D_ADDRESS;
+    const uint8_t pressure_register = use_hbp1201d4 ? 0x04 : 0x06;
+
+    if (!(initialized_tools & tool_mask)) {
+      if (!use_hbp1201d4) {
+        if (!write_register(sensor_address, 0x30, 0x1B)) return false;
+        delay(70);
+      }
+      initialized_tools |= tool_mask;
+    }
+
+    if (use_hbp1201d4) {
+      if (!write_register(sensor_address, 0x01, 0x01)) return false;
+      delay(10);
+    }
+
+    uint8_t data[3];
+    if (!read_registers(sensor_address, pressure_register, data, COUNT(data))) return false;
+
+    for (uint8_t i = 0; i < COUNT(data); ++i) raw_data[i] = data[i];
+
+    const uint32_t raw = (uint32_t(data[0]) << 16) | (uint32_t(data[1]) << 8) | data[2];
+    signed_counts = raw & 0x800000UL
+      ? int32_t(raw - 0x1000000UL)
+      : int32_t(raw);
+    return true;
+  }
+}
+
+void lumen_vacuum_boot_zero() {
+  select_sensor_once();
+  if (!use_hbp1201d4) return; // The original GZP path keeps its native output.
+
+  // Called from setup() after fan outputs have been initialized OFF, before
+  // the command queue can switch either pump or valve. Allow sensor power and
+  // the open pneumatic lines to settle, then average complete 24-bit codes.
+  delay(200);
+  for (uint8_t tool = 1; tool <= 2; ++tool) {
+    int64_t sum = 0;
+    uint8_t samples = 0;
+    for (uint8_t attempt = 0; attempt < 8; ++attempt) {
+      int32_t counts;
+      uint8_t raw_data[3];
+      if (read_pressure_counts(tool, counts, raw_data)) {
+        sum += counts;
+        ++samples;
+      }
+      else delay(10);
+    }
+    if (samples >= 4) {
+      hbp_zero_counts[tool - 1] = int32_t(sum / samples);
+      zeroed_tools |= uint8_t(1U << (tool - 1));
+      SERIAL_ECHO_MSG("HBP VAC", int(tool), " ambient_zero_counts:", hbp_zero_counts[tool - 1]);
+    }
+    else
+      SERIAL_ERROR_MSG("HBP boot ambient zero failed");
+  }
+}
+
+void GcodeSuite::M3427() {
+  const uint8_t tool = parser.byteval('T', 1);
+  int32_t signed_counts;
+  uint8_t raw_data[3];
+
+  if (!read_pressure_counts(tool, signed_counts, raw_data)) {
+    SERIAL_ERROR_MSG("Lumen vacuum sensor read failed");
+    return;
+  }
+
+  if (use_hbp1201d4 && !(zeroed_tools & uint8_t(1U << (tool - 1)))) {
+    SERIAL_ERROR_MSG("HBP boot ambient zero unavailable");
+    return;
+  }
+
+  const int32_t pressure_counts = use_hbp1201d4 ? signed_counts - hbp_zero_counts[tool - 1] : signed_counts;
+  const int32_t pressure_pa = int32_t((int64_t(pressure_counts) * PRESSURE_SPAN_PA) / PRESSURE_COUNTS);
+  const int32_t vacuum_pa = pressure_pa < 0 ? -pressure_pa : 0;
+  // Keep OpenPnP's 255 = ambient / 0 = full vacuum direction. The raw
+  // sensor bytes are reported separately and are never pressure units.
+  const uint8_t vacuum_level = use_hbp1201d4
+    ? uint8_t(255 - _MIN(255L, int32_t((int64_t(vacuum_pa) * 255) / PRESSURE_SPAN_PA)))
+    : raw_data[0];
+  SERIAL_ECHOPGM("pressure_pa:", pressure_pa, " vacuum_pa:", vacuum_pa,
+                 " vacuum_level:", int(vacuum_level), " raw_counts:", signed_counts, " raw_bytes:");
+  SERIAL_ECHO(int(raw_data[0])); SERIAL_CHAR(',');
+  SERIAL_ECHO(int(raw_data[1])); SERIAL_CHAR(',');
+  SERIAL_ECHOLN(int(raw_data[2]));
+}
+
+#endif
