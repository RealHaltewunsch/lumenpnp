+      cooling_needed = cooling_needed || (stepper.axis_enabled.bits & axis_mask)
+        || TERN0(HAS_HEATED_BED, thermalManager.temp_bed.soft_pwm_amount > 0);
+    #endif
+    if (cooling_needed) lastCoolingTrigger = ms;
 
     // Fan Settings. Set fan > 0:
-    //  - If AutoMode is on and steppers have been enabled for CONTROLLERFAN_IDLE_TIME seconds.
+    //  - If AutoMode is on and a cooling trigger was active within CONTROLLERFAN_IDLE_TIME.
     //  - If System is on idle and idle fan speed settings is activated.
     set_fan_speed(
-      settings.auto_mode && lastMotorOn && PENDING(ms, lastMotorOn + SEC_TO_MS(settings.duration))
+      driver_warning || (settings.auto_mode && lastCoolingTrigger && PENDING(ms, lastCoolingTrigger + SEC_TO_MS(settings.duration)))
       ? settings.active_speed : settings.idle_speed
     );
 
@@ -91,7 +128,7 @@ void ControllerFan::update() {
         fan_kick_end = 0;
     #endif
 
-    #if ENABLED(FAN_SOFT_PWM)
+    #if EITHER(FAN_SOFT_PWM, CONTROLLER_FAN_SOFT_PWM)
       thermalManager.soft_pwm_controller_speed = speed;
