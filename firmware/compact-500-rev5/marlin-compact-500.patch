From fa16fcd96d4ea4c4fb6442d6c7507768b735f3bf Mon Sep 17 00:00:00 2001
From: RealHaltewunsch <julius.merz@web.de>
Date: Thu, 19 Nov 2026 12:29:46 +0100
Subject: [PATCH 7/8] Set Compact-500 Z travel and safe homing height

Limit Z to 63 mm, finish homing at the mechanically confirmed 30 mm safe height, and halve the homing feed rates.
---
 Marlin/Configuration.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Marlin/Configuration.h b/Marlin/Configuration.h
index 9a9d2dc2be..cd1e650a52 100644
--- a/Marlin/Configuration.h
+++ b/Marlin/Configuration.h
@@ -1742,7 +1742,7 @@
 //#define Z_HOMING_HEIGHT  4      // (mm) Minimal Z height before homing (G28) for Z clearance above the bed, clamps, ...
                                   // Be sure to have this much clearance over your Z_MAX_POS to prevent grinding.
 
-#define Z_AFTER_HOMING  24.5      // (mm) Height to move to after homing Z
+#define Z_AFTER_HOMING  30.0      // (mm) Height to move to after homing Z
 
 // Direction of endstops when homing; 1=MAX, -1=MIN
 // :[-1,1]
@@ -1770,7 +1770,7 @@
 #define Z_MIN_POS 0
 #define X_MAX_POS X_BED_SIZE
 #define Y_MAX_POS Y_BED_SIZE
-#define Z_MAX_POS 56
+#define Z_MAX_POS 63
 #define I_MIN_POS 0
 #define I_MAX_POS 720
 #define J_MIN_POS 0
@@ -2235,7 +2235,7 @@
 #endif
 
 // Homing speeds (linear=mm/min, rotational=°/min)
-#define HOMING_FEEDRATE_MM_M { (150*60), (150*60), (150*60), (50*60), (50*60) }
+#define HOMING_FEEDRATE_MM_M { (75*60), (75*60), (75*60), (25*60), (25*60) }
 
 // Validate that endstops are triggered on homing moves
 #define VALIDATE_HOMING_ENDSTOPS
-- 
